# Build output
/bin/
/dist/
*.exe

# Bare-named build output. A Linux or macOS build writes an extensionless
# binary into the repo root, which *.exe does not catch.
/ccm
/ccm-tray
/ccm-gui

# Generated at package time from assets/icon.png, not checked in. Unlike
# assets/icon.ico, which is committed so a normal Windows build needs no
# windres, this one is only ever produced on macOS by packaging/macos.
assets/icon.icns
*.iconset/

# Extension build output
extension/node_modules/
extension/out/
extension/*.vsix

# Local scratch
*.local
.DS_Store
Thumbs.db

# Never commit real credential material or a vault, even accidentally.
vault.json
.credentials.json
.claude.json
